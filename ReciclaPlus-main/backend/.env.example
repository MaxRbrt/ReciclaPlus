# Copie este arquivo para ".env" (mesma pasta) e preencha os valores.
# O .env NAO vai para o Git (esta no .gitignore).

# Porta da API
PORTA=3000

# Conexao MySQL
DB_HOST=localhost
DB_PORTA=3306
DB_USUARIO=root
DB_SENHA=sua_senha_do_mysql
DB_NOME=reciclaplus

# Segredo do JWT (troque por uma string longa e aleatoria em producao)
JWT_SEGREDO=reciclaplus_dev_secret_2026
JWT_EXPIRACAO=7d

# Origens permitidas no CORS (separadas por virgula).
# Para dev com Expo, normalmente basta a porta 8081 do Metro.
CORS_ORIGENS=http://localhost:8081,http://127.0.0.1:8081
