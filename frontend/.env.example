# Copie este arquivo para ".env" (mesma pasta) e preencha o valor.
# O .env NAO vai para o Git (esta no .gitignore).

# URL da API. Use o IP DA MAQUINA na rede local, NAO "localhost"
# (o celular fisico nao acessa o localhost do PC).
# Descubra o IP com "ipconfig" (campo "Endereco IPv4").
# Exemplo: EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
EXPO_PUBLIC_API_URL=http://SEU_IP_LOCAL:3000
